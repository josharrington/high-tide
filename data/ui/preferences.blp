using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog _preference_window {
  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      title: _("Audio");
      Adw.ComboRow _quality_row {
        model: StringList {
          strings [
            _("Low 96k"),
            _("High 320k"),
            _("Lossless"),
            _("Hi-res Lossless"),
          ]
        };

        title: _("Quality");
      }
      Adw.ComboRow _sink_row {
        model: StringList {
          strings [
            _("Automatic"),
            "PulseAudio",
            "ALSA",
            "Jack",
            "OSS",
            "Pipewire",
          ]
        };

        title: _("Preferred Audio Sink");
        subtitle: _("Gapless playback is disabled for the native Pipewire Sink due to a bug. Use 'Automatic' for gapless playback.");
      }
      Adw.ComboRow _alsa_device_row{
        title: _("ALSA Device");
        subtitle: _("Device used for exclusive ALSA access");
      }
      Adw.SwitchRow _normalize_row {
        title: _("Normalize volume");
      }
    }

    Adw.PreferencesGroup {
      title: _("Content");
      Adw.ComboRow _ai_content_row {
        model: StringList {
          strings [
            _("Show"),
            _("Hide in playlists"),
            _("Remove entirely"),
          ]
        };
        title: _("AI-generated music");
        subtitle: _("TIDAL labels fully AI-generated recordings. Hiding in playlists keeps them visible elsewhere, while removing entirely also skips them during playback. TIDAL does not expose its own AI preference through the API, so this setting is stored locally.");
      }
      Adw.ActionRow _show_ai_labels_row {
        title: _("Show AI labels");
        subtitle: _("Display the AI badge next to AI-generated tracks and albums.");
        activatable: true;

        [suffix]
        CheckButton _show_ai_labels_check {
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("App");
      Adw.SwitchRow _background_row {
        title: _("Run in the background");
      }
      Adw.SwitchRow _quadratic_volume_row {
        title: _("Use quadratic volume control");
      }
      Adw.SwitchRow _video_cover_row {
        title: _("Display animated covers");
      }
      Adw.SwitchRow _discord_rpc_row {
        title: _("Enable Discord Rich Presence");
      }
    }
  }
}
